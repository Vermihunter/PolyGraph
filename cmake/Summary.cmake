include_guard(GLOBAL)

function(cpgdb_print_summary)
    message(STATUS "")
    message(STATUS "CPGDB configuration")
    message(STATUS "  Version:             ${PROJECT_VERSION}")
    message(STATUS "  Generator:           ${CMAKE_GENERATOR}")
    message(STATUS "  Build type:          ${CMAKE_BUILD_TYPE}")
    message(STATUS "  C++ compiler:        ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
    message(STATUS "")
    message(STATUS "  Backends:            ${CPGDB_BUILD_BACKENDS}")
    message(STATUS "  BFS CLI:             ${CPGDB_BUILD_BFS}")
    message(STATUS "  HTTP server:         ${CPGDB_BUILD_HTTP}")
    message(STATUS "  gRPC server:         ${CPGDB_BUILD_GRPC}")
    message(STATUS "  GPU:                 ${CPGDB_ENABLE_GPU}")
    message(STATUS "  Tests:               ${CPGDB_BUILD_TESTS}")
    message(STATUS "  Documentation:       ${CPGDB_BUILD_DOCS}")
    message(STATUS "")
    message(STATUS "  Profiling:           ${CPGDB_ENABLE_PROFILING}")
    message(STATUS "  Uftrace:             ${CPGDB_ENABLE_UFTRACE}")
    message(STATUS "  clang-format:        ${CPGDB_ENABLE_CLANG_FORMAT}")
    message(STATUS "  clang-tidy:          ${CPGDB_ENABLE_CLANG_TIDY}")
    message(STATUS "  Warnings as errors:  ${CPGDB_WARNINGS_AS_ERRORS}")
    message(STATUS "")
endfunction()
