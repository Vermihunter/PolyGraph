include_guard(GLOBAL)

function(polygraph_print_summary)
    message(STATUS "")
    message(STATUS "PolyGraph configuration")
    message(STATUS "  Version:             ${PROJECT_VERSION}")
    message(STATUS "  Generator:           ${CMAKE_GENERATOR}")
    message(STATUS "  Build type:          ${CMAKE_BUILD_TYPE}")
    message(STATUS "  C++ compiler:        ${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
    message(STATUS "")
    message(STATUS "  Backends:            ${POLYGRAPH_BUILD_BACKENDS}")
    message(STATUS "  BFS CLI:             ${POLYGRAPH_BUILD_BFS}")
    message(STATUS "  HTTP server:         ${POLYGRAPH_BUILD_HTTP}")
    message(STATUS "  gRPC server:         ${POLYGRAPH_BUILD_GRPC}")
    message(STATUS "  GPU:                 ${POLYGRAPH_ENABLE_GPU}")
    message(STATUS "  Tests:               ${POLYGRAPH_BUILD_TESTS}")
    message(STATUS "  Documentation:       ${POLYGRAPH_BUILD_DOCS}")
    message(STATUS "")
    message(STATUS "  Event gathering:     ${POLYGRAPH_ENABLE_EVENT_GATHERING}")
    message(STATUS "  Prometheus metrics:  ${POLYGRAPH_ENABLE_METRICS}")
    message(STATUS "  jemalloc allocator:  ${POLYGRAPH_USE_JEMALLOC}")
    message(STATUS "  Profiling:           ${POLYGRAPH_ENABLE_PROFILING}")
    message(STATUS "  Uftrace:             ${POLYGRAPH_ENABLE_UFTRACE}")
    message(STATUS "  clang-format:        ${POLYGRAPH_ENABLE_CLANG_FORMAT}")
    message(STATUS "  clang-tidy:          ${POLYGRAPH_ENABLE_CLANG_TIDY}")
    message(STATUS "  Warnings as errors:  ${POLYGRAPH_WARNINGS_AS_ERRORS}")
    message(STATUS "")
endfunction()
