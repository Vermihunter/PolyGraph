      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(polygraph_http_request_oldest_in_progress_seconds{route=\"/api/v1/graphs/{id}/bfs\"})",
