  "title": "PolyGraph HTTP / BFS",
  "uid": "polygraph-http",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "title": "Requests in progress",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(polygraph_http_requests_in_progress)",
          "legendFormat": "active",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "BFS in progress",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(polygraph_http_requests_in_progress{route=\"/api/v1/graphs/{id}/bfs\"})",
          "legendFormat": "BFS",
          "refId": "A",
