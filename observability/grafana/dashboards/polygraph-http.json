        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(polygraph_http_request_duration_seconds_sum[1h])) / clamp_min(sum by (route) (rate(polygraph_http_request_duration_seconds_count[1h])), 1e-12)",
          "legendFormat": "avg {{route}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
