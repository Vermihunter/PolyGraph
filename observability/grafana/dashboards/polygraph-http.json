          "refId": "A",
          "range": true
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(polygraph_http_request_duration_seconds_bucket[1h])))",
          "legendFormat": "p95 {{route}}",
          "refId": "B",
          "range": true
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(polygraph_http_request_duration_seconds_bucket[1h])))",
          "legendFormat": "p99 {{route}}",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
