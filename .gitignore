# ============================================================================
# PolyGraph | C++ / CUDA / CMake / Python / Database / Benchmarking
# ============================================================================
# Track source, tests (when ready), example configurations, and documentation.
# Ignore generated state, private configuration, local datasets, and outputs.
# Deliberately DO NOT ignore all *.json, *.txt, *.csv, or *.jsonl files:
#   - Grafana dashboards, graph configurations, fixtures and docs need them.

# ---------------------------------------------------------------------------
# 1. Build directories and CMake-generated files
# ---------------------------------------------------------------------------
/build/
/build-*/
/cmake-build-*/
/out/
/install/

CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
CPackConfig.cmake
CPackSourceConfig.cmake
compile_commands.json
.ninja_deps
.ninja_log

